msgid "Unknown application"
msgstr "Neznana aplikacija"

msgid "No AT-SPI-exposed shortcuts found for this application.\nGTK app? Try Ctrl+? — many bind their own shortcuts window to it."
msgstr "Za to aplikacijo ni bilo najdenih bližnjic, izpostavljenih prek AT-SPI.\nAplikacija GTK? Poskusite Ctrl+? — mnoge nanj vežejo lastno okno z bližnjicami."
