msgid "Unknown application"
msgstr "Aplicacion desconeguda"

msgid "No AT-SPI-exposed shortcuts found for this application.\nGTK app? Try Ctrl+? — many bind their own shortcuts window to it."
msgstr "Cap acorchi exposat per AT-SPI pas trobat per aquesta aplicacion.\nAplicacion GTK? Ensajatz Ctrl+? — fòrça ligan lor fenèstra d'acorchis pròpria a aquò."
