msgid "Unknown application"
msgstr "Aplikazio ezezaguna"

msgid "No AT-SPI-exposed shortcuts found for this application.\nGTK app? Try Ctrl+? — many bind their own shortcuts window to it."
msgstr "Ez da AT-SPI bidez agertutako lasterbiderik aurkitu aplikazio honentzat.\nGTK aplikazioa? Probatu Ctrl+? — askok beren lasterbide-leihoa horri lotzen diote."
